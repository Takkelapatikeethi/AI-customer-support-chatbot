# Local development: renew this non-root profile with aws login.
AWS_PROFILE=company-support-dev
AWS_REGION=us-east-1
DYNAMODB_FAQ_TABLE=company_support_faq
PORT=5000

# AWS RDS MySQL (keep real credentials in .env only)
DB_HOST=your-instance.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=chatbot_db
# Relative paths are resolved from the server directory.
DB_SSL_CA=../Database/certs/us-east-1-bundle.pem
