PORT=5000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0

# Configure an email provider and verified sender to enable recovery.
# Production requires these settings, or an explicit false value below.
AUTH_PASSWORD_RESET_ENABLED=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# AWS RDS MySQL (keep real credentials in .env only)
DB_HOST=your-instance.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=chatbot_db
# Relative paths are resolved from the server directory.
DB_SSL_CA=../Database/certs/us-east-1-bundle.pem
