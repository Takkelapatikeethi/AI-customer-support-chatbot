OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
PORT=5000

# Embeddings use the same server-side OPENAI_API_KEY and OPENAI_BASE_URL.
# Leave semantic retrieval disabled until indexing and score calibration are approved.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
COMPANY_KNOWLEDGE_SEMANTIC_ENABLED=false
# Initial 20-record calibration: target best-match minimum 0.3124, unrelated maximum 0.1398.
# Re-evaluate for a different model, corpus, or workload. Semantic enablement stays opt-in.
COMPANY_KNOWLEDGE_MIN_SIMILARITY=0.30

# AWS RDS MySQL (keep real credentials in .env only)
DB_HOST=your-instance.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=chatbot_db
# Relative paths are resolved from the server directory.
DB_SSL_CA=../Database/certs/us-east-1-bundle.pem
