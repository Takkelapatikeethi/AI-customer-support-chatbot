NODE_ENV=production
PORT=5000
APP_ORIGIN=https://support.example.com
# Set the exact number of trusted proxy hops for your selected host; never use true.
TRUST_PROXY_HOPS=1
DB_HOST=your-private-rds-endpoint
DB_PORT=3306
DB_USER=runtime_user
DB_PASSWORD=configure-in-host-secret-storage
DB_NAME=chatbot_db
DB_SSL_CA=../Database/certs/us-east-1-bundle.pem
# Explicitly disabled until a verified sender/provider is configured.
AUTH_PASSWORD_RESET_ENABLED=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=
